{
  "name": "bulk-call-analysis-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --strictPort",
    "build": "tsc --noEmit && vite build && npm run check:dist",
    "check:dist": "node scripts/check-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@preact/signals": "^2.0.0",
    "@tauri-apps/api": "^2.0.0",
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@preact/preset-vite": "^2.9.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^22.0.0",
    "happy-dom": "^15.11.7",
    "prettier": "3.10.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
