{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bulk Call Analysis",
  "version": "0.1.0",
  "identifier": "app.bulkcallanalysis.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {"script": "npm run build", "cwd": "../ui"},
    "beforeDevCommand": {"script": "npm run dev", "cwd": "../ui"}
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "Bulk Call Analysis",
      "width": 1280,
      "height": 820,
      "minWidth": 1024,
      "minHeight": 680,
      "center": true,
      "create": false,
      "visible": false,
      "resizable": true,
      "fullscreen": false
    }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self'; img-src 'self' asset: data:; style-src 'self'; script-src 'self'"
    },
    "trayIcon": { "iconPath": "icons/tray.png", "tooltip": "Bulk Call Analysis" }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon-32.png",
      "icons/icon.icns"
    ],
    "targets": ["app", "dmg", "nsis"],
    "createUpdaterArtifacts": false,
    "windows": { "nsis": { "installMode": "currentUser" } },
    "macOS": { "signingIdentity": null, "providerShortName": null }
  }
}
